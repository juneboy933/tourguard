# Runtime
NODE_ENV=development
PORT=3001
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Local PostgreSQL (Docker Compose)
POSTGRES_DB=tourguard
POSTGRES_USER=tourguard
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5435
DATABASE_URL=postgresql://tourguard:change-me-for-local-development@localhost:5435/tourguard

# Dashboard authentication
SESSION_SECRET=replace-with-a-long-random-secret

# SMS provider
SMS_PROVIDER=africas-talking
AFRICAS_TALKING_ENV=sandbox
AFRICAS_TALKING_BASE_URL=https://api.sandbox.africastalking.com
AFRICAS_TALKING_USERNAME=replace-with-your-africas-talking-username
AFRICAS_TALKING_API_KEY=replace-with-your-africas-talking-api-key
AFRICAS_TALKING_SENDER_OR_SHORT_CODE=replace-with-your-sender-id-or-short-code

# Set only if the selected Africa's Talking configuration officially supports it.
AFRICAS_TALKING_WEBHOOK_SECRET=

# SMS behavior
SMS_RETRY_LIMIT=3
SMS_TIMEOUT_MS=10000

# Logging and retention
LOG_LEVEL=info
RETENTION_DAYS=365

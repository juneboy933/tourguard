generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  GUIDE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TourStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum InboundMessageStatus {
  RECEIVED
  DUPLICATE
  REJECTED
  PARSED
}

enum OutboundMessageStatus {
  QUEUED
  SUBMITTED
  DELIVERED
  FAILED
  UNKNOWN
}

model Operator {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  sessions  Session[]
  tours     Tour[]
  guests    Guest[]
  inboundMessages  InboundMessage[]
  outboundMessages OutboundMessage[]
}

model User {
  id           String      @id @default(uuid())
  operatorId   String
  name         String
  email        String
  phone        String?
  passwordHash String?
  role         UserRole    @default(STAFF)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  operator     Operator    @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  sessions     Session[]
  guidedTours  Tour[]     @relation("TourGuide")

  @@unique([operatorId, email])
  @@index([operatorId, role])
  @@index([operatorId, status])
}

model Tour {
  id          String     @id @default(uuid())
  operatorId  String
  guideUserId String?
  reference   String
  name        String
  destination String?
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  status      TourStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  operator    Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  guide       User?      @relation("TourGuide", fields: [guideUserId], references: [id], onDelete: Restrict)
  guests      TourGuest[]

  @@unique([operatorId, reference])
  @@index([operatorId, status, startsAt])
  @@index([guideUserId, status])
}

model Guest {
  id          String      @id @default(uuid())
  operatorId  String
  name        String
  phone       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  operator    Operator    @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  tours       TourGuest[]

  @@unique([operatorId, phone])
  @@index([operatorId, name])
}

model TourGuest {
  id         String           @id @default(uuid())
  tourId     String
  guestId    String
  reference  String
  status     MembershipStatus @default(ACTIVE)
  registeredAt DateTime        @default(now())
  removedAt  DateTime?
  tour       Tour             @relation(fields: [tourId], references: [id], onDelete: Cascade)
  guest      Guest            @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([tourId, guestId])
  @@unique([tourId, reference])
  @@index([guestId, status])
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  operatorId     String
  tokenHash      String    @unique
  csrfTokenHash  String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  operator       Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([operatorId, expiresAt])
}

model InboundMessage {
  id                String               @id @default(uuid())
  operatorId        String?
  provider          String
  providerMessageId String?
  fingerprint       String               @unique
  sender            String
  recipient         String?
  text              String
  command           String?
  tourReference     String?
  guestReference    String?
  status            InboundMessageStatus @default(RECEIVED)
  rejectionReason   String?
  rawPayload        Json?
  receivedAt        DateTime
  processedAt       DateTime?
  createdAt         DateTime             @default(now())
  operator          Operator?            @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@unique([provider, providerMessageId])
  @@index([sender, receivedAt])
  @@index([operatorId, status, receivedAt])
}

model OutboundMessage {
  id                String                @id @default(uuid())
  operatorId        String?
  provider          String
  providerMessageId String?
  recipient         String
  messageType       String
  bodyHash          String
  status            OutboundMessageStatus  @default(QUEUED)
  providerMetadata  Json?
  attemptCount      Int                   @default(0)
  lastError         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  operator          Operator?             @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([operatorId, status, createdAt])
  @@index([providerMessageId])
}
